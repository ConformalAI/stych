# Server Configuration
ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Development Mode (DISABLE IN PRODUCTION!)
DEV_MODE=true # To set authentication bypass for testing - true , false for enabling authentication

# If true, any auth session issued before backend restart is rejected.
# Default behavior: true in non-production, false in production.
INVALIDATE_SESSIONS_ON_RESTART=true

# Admin authorization for privileged endpoints (comma-separated)
ADMIN_EMAILS=
ADMIN_USER_IDS=

# Auto-reload on file changes (can be noisy, set to false to disable)
# Use POST /api/admin/reload to manually reload
ENABLE_RELOAD=false

# Max simultaneous detached query runs per user (default 3)
MAX_CONCURRENT_STREAMS_PER_USER=3

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# LLM PROVIDER CONFIGURATION
# ==========================================
# Choose one: litellm (default), openrouter, google, private
# LLM_PROVIDER environment variable will override config.yaml

# LiteLLM Configuration (DEFAULT)
# Connects to your local or remote LiteLLM server
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-your-litellm-key
LITELLM_DEFAULT_MODEL=claude-3-5-sonnet  # Use whatever model is available in your LiteLLM server
# Billing credits conversion: 0.01 means 100 credits = $1.00 estimated usage
CREDIT_USD_PER_CREDIT=0.01

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Google AI Configuration
GOOGLE_API_KEY=AIza-your-google-api-key
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_DEFAULT_MODEL=gemini-1.5-pro

# Alternative: Private LLM Configuration
PRIVATE_LLM_ENABLED=false
PRIVATE_LLM_BASE_URL=http://localhost:8080/v1
PRIVATE_LLM_MODEL=llama-3.1-70b

# ==========================================
# LANGFUSE TRACKING CONFIGURATION
# ==========================================
# Enable Langfuse for LLM call tracking and observability
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-your-public-key
LANGFUSE_SECRET_KEY=sk-your-secret-key
LANGFUSE_HOST=http://localhost:3110  # Your Langfuse instance URL
# For Langfuse Cloud: https://cloud.langfuse.com

# ==========================================
# Secret key — used for:
#   1. Fernet encryption of saved connection credentials and MCP tokens
#   2. ALGORITHM / ACCESS_TOKEN_EXPIRE_MINUTES (legacy JWT helpers)
# validate_security_config() blocks startup if this is left at the default
# value in a production-like environment.  Use a long random string.
# ==========================================
SECRET_KEY=your_secret_key_here_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# SUPERTOKENS CONFIGURATION
# ==========================================
# Connection to the SuperTokens Core container
# Run it with the root docker-compose.yml, or see https://supertokens.com/docs for other setups.
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=change-me-matches-core-API_KEYS-env

# Domain settings — must match what the browser sees.
# For Vite dev proxy flow (/auth proxied via :5173), API_DOMAIN should be :5173.
API_DOMAIN=http://localhost:5173
WEBSITE_DOMAIN=http://localhost:5173

# Google OAuth via SuperTokens (get from https://console.cloud.google.com/apis/credentials)
# Both client_id AND client_secret are required for the server-side OAuth flow
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# MCP integration OAuth (Settings → Connect with Google). Browser-visible origin
# only — defaults to API_DOMAIN if unset. Register each callback in Google Console:
#   {GOOGLE_OAUTH_REDIRECT_BASE_URI}/api/integrations/google_sheets/oauth/callback
#   {GOOGLE_OAUTH_REDIRECT_BASE_URI}/api/integrations/google_drive/oauth/callback
# (and google_docs, google_slides if used)
# GOOGLE_OAUTH_REDIRECT_BASE_URI=https://app.example.com

# ==========================================
# File Upload Settings
# ==========================================
MAX_UPLOAD_SIZE=50  # MB
UPLOAD_DIR=./data/uploads
TEMP_DIR=./data/temp

# Cleaning ReAct sandboxes (default: <repo>/data/cleaning_workspaces). Set an
# absolute path in Docker so workspaces stay outside the mounted backend tree.
# CLEANING_WORKSPACE_BASE=/stych-data/cleaning_workspaces

# ==========================================
# Agent Configuration
# ==========================================
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=300  # seconds
ENABLE_A2A=true

# ==========================================
# A2A Server Configuration
# ==========================================
A2A_SERVER_HOST=0.0.0.0
A2A_SERVER_PORT=8001
A2A_AGENT_ID=stych-data-agent
A2A_AGENT_NAME=Stych Data Analysis Agent

# ==========================================
# Database Configuration
# ==========================================
# App-owned database (PostgreSQL only; separate from SuperTokens Core DB)
APP_DATABASE_URL=postgresql://stych:stych_pass@localhost:5432/stych_app
APP_DB_SCHEMA=public
APP_DB_REQUIRE_POSTGRES=true

# Backward-compat fallback (prefer APP_DATABASE_URL)
DATABASE_URL=

# Docker only: the container entrypoint runs scripts/migrate.py before starting the API.
# Empty database -> schema created and marked as current; tracked database -> `alembic upgrade head`.
# Set RUN_MIGRATIONS=false to skip. For a database with tables but no Alembic history, set
# ALEMBIC_BASELINE_REVISION to the revision it matches (one-time) so migrations can continue.
# RUN_MIGRATIONS=true
# ALEMBIC_BASELINE_REVISION=

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=./logs/stych.log

# ==========================================
# External Data Sources (future features)
# ==========================================
BIGQUERY_ENABLED=false
BIGQUERY_PROJECT_ID=

MONGODB_ENABLED=false
MONGODB_URI=

# ==========================================
# Hindsight long-term memory (external service)
# ==========================================
# Deploy Hindsight separately; the backend only needs the API URL.
# Web UI (optional, for admin): http://localhost:9999 — see frontend VITE_HINDSIGHT_WEB_UI_URL
HINDSIGHT_ENABLED=true
HINDSIGHT_URL=http://localhost:8888
