# Configuration for the self-hosted stack (docker-compose.yml).
# Copy to .env and fill in every value marked REQUIRED.
#
# Use letters and digits only (e.g. generated hex) for the passwords and keys below - they are
# embedded in connection URLs. Generate a value with any tool you like, for example:
#   openssl rand -hex 32

# ── Where users reach the app ─────────────────────────────────────────────────
# The exact URL in the browser's address bar, without a trailing slash.
# Behind a domain / reverse proxy, set it to e.g. https://stych.example.com
PUBLIC_URL=http://localhost:8080
# Host port the web UI is published on.
STYCH_PORT=8080

# ── Secrets (REQUIRED) ────────────────────────────────────────────────────────
# App database password.
POSTGRES_PASSWORD=
# Auth (SuperTokens) database password.
SUPERTOKENS_DB_PASSWORD=
# Shared key between the backend and the SuperTokens core. At least 20 characters.
SUPERTOKENS_API_KEY=
# Encrypts saved data-source credentials. At least 32 characters. Do not change it later
# or saved connections will become unreadable.
SECRET_KEY=
# Key the backend uses to talk to the bundled LiteLLM gateway. Any random value.
LITELLM_MASTER_KEY=

# ── LLM provider (set at least one key) ───────────────────────────────────────
# Default model is routed through the bundled LiteLLM gateway (docker/litellm_config.yaml).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LITELLM_DEFAULT_MODEL=openrouter/anthropic/claude-sonnet-4.5

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated emails that get admin rights when they sign up.
ADMIN_EMAILS=

# ── Optional: "Sign in with Google" ───────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials and add
#   {PUBLIC_URL}/auth/callback/google
# as an authorized redirect URI. Leave empty to use email + password only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
