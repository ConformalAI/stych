{
  "name": "stych-2.0",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "description": "Stych data agent frontend - AI-powered data analysis and cleaning",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "contracts:export": "cd ../backend && uv run python scripts/export_contract_schemas.py",
    "codegen:ts": "node scripts/codegen-contracts.cjs",
    "codegen": "npm run contracts:export && npm run codegen:ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/generated",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "lint:strict": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "clean": "rm -rf dist node_modules/.vite node_modules/.cache",
    "clean:dist": "rm -rf dist",
    "clean:cache": "rm -rf node_modules/.vite node_modules/.cache",
    "pretest": "npm run codegen:check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-oauth/google": "^0.13.4",
    "@tanstack/react-query": "^5.17.9",
    "@xyflow/react": "^12.11.5",
    "axios": "^1.6.5",
    "echarts": "^6.1.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^0.303.0",
    "minimatch": "^10.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-force-graph-2d": "^1.29.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.21.1",
    "recharts": "^2.10.3",
    "remark-gfm": "^4.0.1",
    "supertokens-auth-react": "^0.51.2",
    "uuid": "^9.0.1",
    "vega": "^5.32.0",
    "vega-embed": "^6.29.0",
    "vega-lite": "^5.23.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "postcss": "^8.4.33",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
