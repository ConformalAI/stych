VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Show the "Dev Login (Skip Auth)" button on the login page.
# Requires DEV_MODE=true on the backend too. Never set in production.
VITE_DEV_MODE=false

# SuperTokens — both values should be the URL the *browser* uses to reach the app.
# In dev, /auth and /api are proxied through Vite so both point to the frontend origin.
# In production, set these to the actual domains (can differ if API is on a subdomain).
VITE_SUPERTOKENS_API_DOMAIN=http://localhost:5173
VITE_SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:5173

# Comma-separated list of hostnames the Vite dev server will accept requests from
# Example: VITE_ALLOWED_HOSTS=app.example.com,localhost
VITE_ALLOWED_HOSTS=localhost

# Hindsight — deployed separately. Backend uses HINDSIGHT_URL; Web UI is optional admin UI.
VITE_HINDSIGHT_WEB_UI_URL=http://localhost:9999
